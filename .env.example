# 与调度中心、分析服务相同的服务凭据（至少 16 位）
VC_SERVICE_TOKEN=
# 调度中心地址和它的 Redis
VC_SCHEDULER_URL=http://127.0.0.1:8080
VC_REDIS_URL=redis://localhost:6379/0
# 设备标识，默认 crawler-<主机名>；一台机器跑多个时各填一个
# VC_INSTANCE_ID=
# 控制接口监听的地址；调度中心访问本程序的地址默认是 http://<host>:<port>
VC_HOST=127.0.0.1
VC_PORT=8091
# VC_PUBLIC_URL=
# 下载中的文件和身份的浏览器资料目录（含 Cookie，不要放进仓库）
VC_DATA_DIR=data
VC_PROFILE_ROOT=profiles
# 低速断开阈值（字节/秒）和统计窗口（秒）
VC_DOWNLOAD_SLOW_BYTES=20480
VC_DOWNLOAD_SLOW_WINDOW=45
# 设为 1 禁用分片，最小文件长度的单位为字节
VC_DOWNLOAD_RANGE_PARTS=4
VC_DOWNLOAD_RANGE_MIN_BYTES=1048576
# 优先下载的最高分辨率，按画面短边的像素数计算
CRAWLER_MAX_VIDEO_HEIGHT=720
# 同时获取几个达人、同时下载几条在调度中心“执行程序”页设置，身份要保持几个在“账号池”页面设置
# 预热身份用无头 Chrome（默认 1）。只影响拿 Cookie 那一步，采集作品始终有界面
VC_WARM_HEADLESS=1
